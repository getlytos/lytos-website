---
import Default from '@astrojs/starlight/components/Footer.astro';

const locale = Astro.locals?.starlightRoute?.locale;
const isFr = locale === 'fr';

const docsPath = isFr ? '/fr/getting-started/introduction/' : '/en/getting-started/introduction/';
const tagline = isFr
	? 'une méthode de travail avec les LLM'
	: 'a human-first method for working with AI agents';
---

<Default><slot /></Default>

<footer class="lytos-ft lytos-ft-v1">
	<span class="lytos-ft-brand">Lytos</span>
	<span>{tagline}</span>
	<span class="lytos-ft-sep">·</span>
	<a href="https://github.com/getlytos/lytos-method" target="_blank" rel="noopener noreferrer">GitHub</a>
	<a href={docsPath}>{isFr ? 'Documentation' : 'Documentation'}</a>
	<a href="mailto:frederic@galline.fr">Contact</a>
	<span class="lytos-ft-sep">·</span>
	<span>MIT · CC BY-SA 4.0</span>
	<span class="lytos-ft-meta">v0.1 · 2026</span>
</footer>
