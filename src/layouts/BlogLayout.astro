---
import '../styles/custom.css';
import { blogLocales, type BlogLang } from '../lib/blog';

interface Props {
	title: string;
	description: string;
	lang: BlogLang;
}

const { title, description, lang } = Astro.props;
const labels = blogLocales[lang];
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://lytos.org';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = title === 'Lytos' ? title : `${title} | Lytos`;
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Lytos" />
		<meta property="og:image" content={`${siteUrl}/og-default.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}/og-default.png`} />
	</head>
	<body class="blog-shell">
		<header class="blog-header">
			<a class="blog-brand" href={`/${lang}/`}>{labels.home}</a>
			<nav class="blog-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
				<a href={`/${lang}/method/manifest/`}>{labels.docs}</a>
				<a href={`/${lang}/cli/overview/`}>{labels.cli}</a>
				<a aria-current="page" href={`/${lang}/blog/`}>{labels.blog}</a>
				<a href={`/${lang}/contact/`}>{labels.contact}</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="blog-footer">
			<span>Lytos</span>
			<a href={`/${lang}/blog/`}>{labels.blog}</a>
			<a href="https://github.com/getlytos/lytos-cli" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href={`/${lang}/contact/`}>{labels.contact}</a>
		</footer>
	</body>
</html>

<style is:global>
	.blog-shell {
		margin: 0;
		min-height: 100vh;
		background: var(--lytos-paper);
		color: var(--lytos-ink);
		font-family: var(--sl-font-system);
	}

	.blog-shell a {
		color: inherit;
		text-decoration-color: var(--lytos-ink-12);
		text-underline-offset: 0.18em;
		transition:
			color var(--lytos-dur) var(--lytos-ease),
			text-decoration-color var(--lytos-dur) var(--lytos-ease);
	}

	.blog-shell a:hover {
		color: var(--lytos-olive-deep);
		text-decoration-color: var(--lytos-olive-deep);
	}

	.blog-header,
	.blog-footer,
	.blog-container {
		width: min(100% - 2rem, 68rem);
		margin-inline: auto;
	}

	.blog-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--lytos-ink-08);
	}

	.blog-brand {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 1.6rem;
		font-weight: 200;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.blog-nav {
		display: flex;
		gap: 1.1rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.blog-nav a {
		color: var(--lytos-ink-soft);
		text-decoration: none;
	}

	.blog-nav a[aria-current='page'] {
		color: var(--lytos-olive-deep);
	}

	.blog-hero {
		padding-block: clamp(3rem, 8vw, 6rem) 2rem;
	}

	.blog-kicker,
	.blog-meta,
	.blog-pill,
	.blog-back {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.blog-kicker,
	.blog-meta {
		color: var(--lytos-ink-soft);
	}

	.blog-title {
		max-width: 14ch;
		margin: 0.6rem 0 1rem;
		font-family: 'Newsreader', Georgia, serif;
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.02em;
	}

	.blog-description {
		max-width: 42rem;
		margin: 0;
		color: var(--lytos-ink-soft);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.55;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 16rem;
		gap: clamp(2rem, 6vw, 5rem);
		padding-block: 2rem 5rem;
	}

	.blog-list {
		display: grid;
		gap: 1.5rem;
	}

	.blog-card {
		padding-block: 1.5rem;
		border-top: 1px solid var(--lytos-ink-08);
	}

	.blog-card h2 {
		margin: 0.35rem 0 0.65rem;
		font-family: 'Newsreader', Georgia, serif;
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.015em;
	}

	.blog-card h2 a {
		text-decoration: none;
	}

	.blog-card p {
		max-width: 45rem;
		margin: 0;
		color: var(--lytos-ink-soft);
		line-height: 1.6;
	}

	.blog-sidebar {
		display: grid;
		align-content: start;
		gap: 2rem;
	}

	.blog-sidebar h2 {
		margin: 0 0 0.75rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.blog-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-pill {
		display: inline-flex;
		gap: 0.35rem;
		align-items: center;
		padding: 0.35rem 0.55rem;
		border: 1px solid var(--lytos-ink-12);
		border-radius: 2px;
		color: var(--lytos-ink-soft);
		text-decoration: none;
	}

	.blog-pill:hover {
		border-color: var(--lytos-olive-line);
	}

	.blog-article {
		width: min(100% - 2rem, 46rem);
		margin-inline: auto;
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.blog-article-header {
		margin-bottom: 2.5rem;
	}

	.blog-article-title {
		margin: 0.8rem 0 1rem;
		font-family: 'Newsreader', Georgia, serif;
		font-size: clamp(2.8rem, 8vw, 5.6rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.blog-content {
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.blog-content h2 {
		margin: 2.5rem 0 1rem;
		font-family: 'Newsreader', Georgia, serif;
		font-size: clamp(1.9rem, 4vw, 2.5rem);
		font-weight: 500;
		line-height: 1.12;
	}

	.blog-content p,
	.blog-content ul,
	.blog-content ol {
		margin-block: 1.1rem;
	}

	.blog-content hr {
		margin-block: 2rem;
		border: 0;
		border-top: 1px solid var(--lytos-ink-08);
	}

	.blog-back {
		display: inline-block;
		margin-top: 2.5rem;
		color: var(--lytos-ink-soft);
	}

	.blog-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		padding-block: 1.5rem 2rem;
		border-top: 1px solid var(--lytos-ink-08);
		color: var(--lytos-ink-soft);
		font-size: 0.85rem;
	}

	.blog-footer span {
		color: var(--lytos-ink);
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 48rem) {
		.blog-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.blog-nav {
			flex-wrap: wrap;
		}

		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
